+// __ballot_sync() and __ballot() cover a whole hardware warp or wavefront,
+// but OnesweepReorder splits the block into WARP_SIZE-wide logical warps and a
+// 64-wide wavefront holds two of them. Return only the calling lane's own
+// logical warp, so bit i of the result belongs to its lane i. On a 32-wide
+// wavefront the shift is zero and the result is unchanged.
+__device__ inline u32 logicalWarpBallot( bool predicate )
+{
+#if defined( ITS )
+	return __ballot_sync( 0xFFFFFFFF, predicate );
+#else
+	const u32 logicalWarpInWave = ( threadIdx.x % warpSize ) / WARP_SIZE;
+	return static_cast<u32>( __ballot( predicate ) >> ( logicalWarpInWave * WARP_SIZE ) );
+#endif
+}
