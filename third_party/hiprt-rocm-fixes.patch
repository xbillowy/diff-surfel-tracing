 using namespace hiprt;
 
+// On Windows, LoadLibraryA with a bare DLL name uses the legacy DLL search
+// order (System32 before PATH entries) so "amdhip64_7.dll" from the AMD
+// display driver wins over the ROCm SDK's copy.  Build full-path lists from
+// ROCM_PATH / HIP_PATH so the ROCm SDK DLLs are loaded instead.
+struct DllPathList {
+    std::vector<std::string> strs;
+    std::vector<const char*> ptrs;
+
+    void build( const char** bare, const char* rocm_dir, const char* versionedPrefix = nullptr ) {
+        strs.clear(); ptrs.clear();
+        if ( rocm_dir && versionedPrefix ) {
+            // The version digits in the DLL name change layout between ROCm
+            // releases (hiprtc0605.dll, hiprtc07013.dll), so a fixed name list
+            // goes stale; take whichever versioned copy the SDK ships.
+            std::error_code ec;
+            for ( const auto& e : std::filesystem::directory_iterator( std::filesystem::path( rocm_dir ) / "bin", ec ) ) {
+                const std::string n = e.path().filename().string();
+                if ( n.rfind( versionedPrefix, 0 ) == 0 && n.size() > 4 && n.compare( n.size() - 4, 4, ".dll" ) == 0 )
+                    strs.push_back( e.path().string() );
+            }
+        }
+        if ( rocm_dir ) {
+            for ( const char** p = bare; *p; ++p )
+                strs.push_back( std::string( rocm_dir ) + "\\bin\\" + *p );
+        }
+        for ( const char** p = bare; *p; ++p )
+            strs.push_back( *p );
+        for ( auto& s : strs ) ptrs.push_back( s.c_str() );
+        ptrs.push_back( nullptr );
+    }
+    const char** data() { return ptrs.data(); }
+};
